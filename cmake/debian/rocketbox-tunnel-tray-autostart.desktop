[Desktop Entry]
Type=Application
Name=RocketBox Tunnel Tray
Comment=RocketBox Tunnel system tray (starts quietly at login)
Exec=rocketbox-tunnel-tray --background
Icon=rocketbox
Terminal=false
Categories=Network;System;Utility;
Keywords=RocketBox;tunnel;USB;tray;
StartupNotify=false
X-GNOME-Autostart-enabled=true
NoDisplay=true
