#!/bin/sh
# Optional udev rule install after deb package install.
set -e
for RULE in 99-rocketbox-usb.rules 99-sls-fabric-usb.rules; do
  RULE_SRC="/usr/share/rocketbox/$RULE"
  RULE_DST="/etc/udev/rules.d/$RULE"
  if [ -f "$RULE_SRC" ] && [ ! -f "$RULE_DST" ]; then
    cp "$RULE_SRC" "$RULE_DST"
  fi
done
udevadm control --reload-rules 2>/dev/null || true
udevadm trigger 2>/dev/null || true
# Refresh desktop/icon caches when present (tray/app menu + Icon=rocketbox).
update-desktop-database /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
